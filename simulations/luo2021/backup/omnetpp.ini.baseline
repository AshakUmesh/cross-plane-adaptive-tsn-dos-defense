[General]
network = Luo2021Network

# ============================================================
# SIMULATION TIME — Luo 2021 Section 5.1: "150ms"
# ============================================================
sim-time-limit = 150ms

# ============================================================
# ETHERNET SPEED — Luo 2021 Section 5.1: "100 Mbps"
# ============================================================
*.*.eth[*].bitrate = 100Mbps

# ============================================================
# SWITCH BUFFER — Luo 2021 Section 5.1: "max 30 packets"
# ============================================================
*.viuSwitch.eth[*].macLayer.queue.packetCapacity = 30
*.vcuSwitch.eth[*].macLayer.queue.packetCapacity = 30

# ============================================================
# TAS — Enable egress traffic shaping (IEEE 802.1Qbv)
# Luo Section 5: "TAS defined in IEEE 802.1Qbv is also applied"
# ============================================================
*.viuSwitch.hasEgressTrafficShaping = true
*.vcuSwitch.hasEgressTrafficShaping = true

# ============================================================
# 8 TRAFFIC CLASSES — Luo uses Q0-Q7
# ============================================================
*.viuSwitch.eth[*].macLayer.queue.numTrafficClasses = 8
*.vcuSwitch.eth[*].macLayer.queue.numTrafficClasses = 8

# ============================================================
# GCL — EXACTLY Luo Table 6
# Cycle = 500us
# Slot 1: 0-125us    → Q7 OPEN only  (Control data, PCP=7)
# Slot 2: 125-450us  → Q0-Q6 OPEN    (AV1, AV2, Radar, PCP=4)
# Slot 3: 450-500us  → ALL CLOSED    (guard band)
#
# INET GCL syntax: durations = [slot1_duration, slot2_duration, slot3_duration]
# initiallyOpen = true means gate opens at start of first slot
# initiallyOpen = false means gate is closed at start of first slot
#
# Q7 (Control, PCP=7): OPEN 0-125us, CLOSED 125-500us
# Durations: [125us, 375us]  initiallyOpen: true
#
# Q0-Q6 (AV+Radar, PCP=4): CLOSED 0-125us, OPEN 125-450us, CLOSED 450-500us
# Durations: [125us, 325us, 50us]  initiallyOpen: false
# ============================================================

# Q7 — Control stream (PCP=7): open first 125us only
*.viuSwitch.eth[*].macLayer.queue.transmissionGate[7].durations = [125us, 375us]
*.viuSwitch.eth[*].macLayer.queue.transmissionGate[7].initiallyOpen = true
*.vcuSwitch.eth[*].macLayer.queue.transmissionGate[7].durations = [125us, 375us]
*.vcuSwitch.eth[*].macLayer.queue.transmissionGate[7].initiallyOpen = true

# Q0-Q6 — AV + Radar streams (PCP=4): open 125-450us
*.viuSwitch.eth[*].macLayer.queue.transmissionGate[0].durations = [125us, 375us]
*.viuSwitch.eth[*].macLayer.queue.transmissionGate[0].initiallyOpen = false
*.viuSwitch.eth[*].macLayer.queue.transmissionGate[1].durations = [125us, 375us]
*.viuSwitch.eth[*].macLayer.queue.transmissionGate[1].initiallyOpen = false
*.viuSwitch.eth[*].macLayer.queue.transmissionGate[2].durations = [125us, 375us]
*.viuSwitch.eth[*].macLayer.queue.transmissionGate[2].initiallyOpen = false
*.viuSwitch.eth[*].macLayer.queue.transmissionGate[3].durations = [125us, 375us]
*.viuSwitch.eth[*].macLayer.queue.transmissionGate[3].initiallyOpen = false
*.viuSwitch.eth[*].macLayer.queue.transmissionGate[4].durations = [125us, 375us]
*.viuSwitch.eth[*].macLayer.queue.transmissionGate[4].initiallyOpen = false
*.viuSwitch.eth[*].macLayer.queue.transmissionGate[5].durations = [125us, 375us]
*.viuSwitch.eth[*].macLayer.queue.transmissionGate[5].initiallyOpen = false
*.viuSwitch.eth[*].macLayer.queue.transmissionGate[6].durations = [125us, 375us]
*.viuSwitch.eth[*].macLayer.queue.transmissionGate[6].initiallyOpen = false

*.vcuSwitch.eth[*].macLayer.queue.transmissionGate[0].durations = [125us, 375us]
*.vcuSwitch.eth[*].macLayer.queue.transmissionGate[0].initiallyOpen = false
*.vcuSwitch.eth[*].macLayer.queue.transmissionGate[1].durations = [125us, 375us]
*.vcuSwitch.eth[*].macLayer.queue.transmissionGate[1].initiallyOpen = false
*.vcuSwitch.eth[*].macLayer.queue.transmissionGate[2].durations = [125us, 375us]
*.vcuSwitch.eth[*].macLayer.queue.transmissionGate[2].initiallyOpen = false
*.vcuSwitch.eth[*].macLayer.queue.transmissionGate[3].durations = [125us, 375us]
*.vcuSwitch.eth[*].macLayer.queue.transmissionGate[3].initiallyOpen = false
*.vcuSwitch.eth[*].macLayer.queue.transmissionGate[4].durations = [125us, 375us]
*.vcuSwitch.eth[*].macLayer.queue.transmissionGate[4].initiallyOpen = false
*.vcuSwitch.eth[*].macLayer.queue.transmissionGate[5].durations = [125us, 375us]
*.vcuSwitch.eth[*].macLayer.queue.transmissionGate[5].initiallyOpen = false
*.vcuSwitch.eth[*].macLayer.queue.transmissionGate[6].durations = [125us, 375us]
*.vcuSwitch.eth[*].macLayer.queue.transmissionGate[6].initiallyOpen = false

# ============================================================
# PSFP — Enable ingress filtering (IEEE 802.1Qci)
# Luo: ADS strategies applied in switch1 (viuSwitch)
# ============================================================
*.viuSwitch.hasIngressTrafficFiltering = true
*.vcuSwitch.hasIngressTrafficFiltering = true

# ============================================================
# AV1 — Forward camera stream
# Luo Table 5: PCP=4, interval=90us, size=400-500B,
#              startTime=100us, quantity=3 per cycle
# ============================================================
*.av1.numApps = 1
*.av1.app[0].typename = "UdpSourceApp"
*.av1.app[0].io.destAddress = "centralHost"
*.av1.app[0].io.destPort = 5001
*.av1.app[0].source.packetLength = 500B
*.av1.app[0].source.productionInterval = 90us
*.av1.app[0].source.initialProductionOffset = 100us

# Stream identification + PCP encoding — PCP=4 (Luo item 3)
*.av1.hasOutgoingStreams = true
*.av1.bridging.streamIdentifier.identifier.mapping = [{stream: "av1", packetFilter: expr(has(udp) && udp.destPort == 5001)}]
*.av1.bridging.streamCoder.encoder.mapping = [{stream: "av1", pcp: 4}]

# ============================================================
# AV2 — Forward camera stream 2
# Luo Table 5: PCP=4, interval=90us, size=400-500B,
#              startTime=145us (STAGGERED from AV1)
# ============================================================
*.av2.numApps = 1
*.av2.app[0].typename = "UdpSourceApp"
*.av2.app[0].io.destAddress = "centralHost"
*.av2.app[0].io.destPort = 5002
*.av2.app[0].source.packetLength = 500B
*.av2.app[0].source.productionInterval = 90us
*.av2.app[0].source.initialProductionOffset = 145us

# Stream identification + PCP encoding — PCP=4
*.av2.hasOutgoingStreams = true
*.av2.bridging.streamIdentifier.identifier.mapping = [{stream: "av2", packetFilter: expr(has(udp) && udp.destPort == 5002)}]
*.av2.bridging.streamCoder.encoder.mapping = [{stream: "av2", pcp: 4}]

# ============================================================
# RADAR — Radar data stream
# Luo Table 5: PCP=4, interval=500us, size=64B, startTime=100us
# ============================================================
*.radarNode.numApps = 1
*.radarNode.app[0].typename = "UdpSourceApp"
*.radarNode.app[0].io.destAddress = "centralHost"
*.radarNode.app[0].io.destPort = 5003
*.radarNode.app[0].source.packetLength = 64B
*.radarNode.app[0].source.productionInterval = 500us
*.radarNode.app[0].source.initialProductionOffset = 100us

# Stream identification + PCP encoding — PCP=4 (Luo item 4)
*.radarNode.hasOutgoingStreams = true
*.radarNode.bridging.streamIdentifier.identifier.mapping = [{stream: "radar", packetFilter: expr(has(udp) && udp.destPort == 5003)}]
# ============================================================
# CONTROL — Control data stream
# Luo Table 5: PCP=7 (HIGHEST), interval=500us, size=20B, startTime=0us
# ============================================================
*.zonalHost.numApps = 1
*.zonalHost.app[0].typename = "UdpSourceApp"
*.zonalHost.app[0].io.destAddress = "centralHost"
*.zonalHost.app[0].io.destPort = 5004
*.zonalHost.app[0].source.packetLength = 20B
*.zonalHost.app[0].source.productionInterval = 500us
*.zonalHost.app[0].source.initialProductionOffset = 0us

# Stream identification + PCP encoding — PCP=7 (Luo item 2: "highest priority")
*.zonalHost.hasOutgoingStreams = true
*.zonalHost.bridging.streamIdentifier.identifier.mapping = [{stream: "control", packetFilter: expr(has(udp) && udp.destPort == 5004)}]
*.zonalHost.bridging.streamCoder.encoder.mapping = [{stream: "control", pcp: 7}]
*.viuSwitch.bridging.streamCoder.decoder.mapping = [{source: "av1", pcp: 4, stream: "av1"}, {source: "av2", pcp: 4, stream: "av2"}, {source: "radarNode", pcp: 4, stream: "radar"}, {source: "zonalHost", pcp: 7, stream: "control"}]
*.vcuSwitch.bridging.streamCoder.decoder.mapping = [{source: "av1", pcp: 4, stream: "av1"}, {source: "av2", pcp: 4, stream: "av2"}, {source: "radarNode", pcp: 4, stream: "radar"}, {source: "zonalHost", pcp: 7, stream: "control"}]
*.viuSwitch.bridging.streamFilter.ingress.numStreams = 4
*.viuSwitch.bridging.streamFilter.ingress.classifier.mapping = {"av1":0,"av2":1,"radar":2,"control":3}

# --- Stream Filter 1: MSDU size check ---
# Luo Table 7: AV1/AV2 MSDU=530B, Radar/Control MSDU=100B
*.viuSwitch.bridging.streamFilter.ingress.filter[0].streamName = "av1"
*.viuSwitch.bridging.streamFilter.ingress.filter[0].maxDataLength = 530B

*.viuSwitch.bridging.streamFilter.ingress.filter[1].streamName = "av2"
*.viuSwitch.bridging.streamFilter.ingress.filter[1].maxDataLength = 530B

*.viuSwitch.bridging.streamFilter.ingress.filter[2].streamName = "radar"
*.viuSwitch.bridging.streamFilter.ingress.filter[2].maxDataLength = 100B

*.viuSwitch.bridging.streamFilter.ingress.filter[3].streamName = "control"
*.viuSwitch.bridging.streamFilter.ingress.filter[3].maxDataLength = 100B

# --- Flow Meter: Token bucket ---
# Luo Table 7: AV1/AV2: CIR=22Mbps, CBS=5004B, EIR=4Mbps, EBS=1000B
#              Radar/Control: CIR=1Mbps, CBS=1002B, EIR=1Mbps, EBS=100B
*.viuSwitch.bridging.streamFilter.ingress.meter[0].typename = "SingleRateTwoColorMeter"
*.viuSwitch.bridging.streamFilter.ingress.meter[0].committedInformationRate = 22Mbps
*.viuSwitch.bridging.streamFilter.ingress.meter[0].committedBurstSize = 5004B

*.viuSwitch.bridging.streamFilter.ingress.meter[1].typename = "SingleRateTwoColorMeter"
*.viuSwitch.bridging.streamFilter.ingress.meter[1].committedInformationRate = 22Mbps
*.viuSwitch.bridging.streamFilter.ingress.meter[1].committedBurstSize = 5004B

*.viuSwitch.bridging.streamFilter.ingress.meter[2].typename = "SingleRateTwoColorMeter"
*.viuSwitch.bridging.streamFilter.ingress.meter[2].committedInformationRate = 1Mbps
*.viuSwitch.bridging.streamFilter.ingress.meter[2].committedBurstSize = 1002B

*.viuSwitch.bridging.streamFilter.ingress.meter[3].typename = "SingleRateTwoColorMeter"
*.viuSwitch.bridging.streamFilter.ingress.meter[3].committedInformationRate = 1Mbps
*.viuSwitch.bridging.streamFilter.ingress.meter[3].committedBurstSize = 1002B

# vcuSwitch mirrors viuSwitch (Luo: both switches same config)
*.vcuSwitch.bridging.streamFilter.ingress.numStreams = 4

*.vcuSwitch.bridging.streamFilter.ingress.classifier.mapping = {"av1":0,"av2":1,"radar":2,"control":3}

*.vcuSwitch.bridging.streamFilter.ingress.filter[0].streamName = "av1"
*.vcuSwitch.bridging.streamFilter.ingress.filter[0].maxDataLength = 530B
*.vcuSwitch.bridging.streamFilter.ingress.filter[1].streamName = "av2"
*.vcuSwitch.bridging.streamFilter.ingress.filter[1].maxDataLength = 530B
*.vcuSwitch.bridging.streamFilter.ingress.filter[2].streamName = "radar"
*.vcuSwitch.bridging.streamFilter.ingress.filter[2].maxDataLength = 100B
*.vcuSwitch.bridging.streamFilter.ingress.filter[3].streamName = "control"
*.vcuSwitch.bridging.streamFilter.ingress.filter[3].maxDataLength = 100B

*.vcuSwitch.bridging.streamFilter.ingress.meter[0].typename = "SingleRateTwoColorMeter"
*.vcuSwitch.bridging.streamFilter.ingress.meter[0].committedInformationRate = 22Mbps
*.vcuSwitch.bridging.streamFilter.ingress.meter[0].committedBurstSize = 5004B
*.vcuSwitch.bridging.streamFilter.ingress.meter[1].typename = "SingleRateTwoColorMeter"
*.vcuSwitch.bridging.streamFilter.ingress.meter[1].committedInformationRate = 22Mbps
*.vcuSwitch.bridging.streamFilter.ingress.meter[1].committedBurstSize = 5004B
*.vcuSwitch.bridging.streamFilter.ingress.meter[2].typename = "SingleRateTwoColorMeter"
*.vcuSwitch.bridging.streamFilter.ingress.meter[2].committedInformationRate = 1Mbps
*.vcuSwitch.bridging.streamFilter.ingress.meter[2].committedBurstSize = 1002B
*.vcuSwitch.bridging.streamFilter.ingress.meter[3].typename = "SingleRateTwoColorMeter"
*.vcuSwitch.bridging.streamFilter.ingress.meter[3].committedInformationRate = 1Mbps
*.vcuSwitch.bridging.streamFilter.ingress.meter[3].committedBurstSize = 1002B

# ============================================================
# CENTRALHOST SINKS — 4 ports
# ============================================================
*.centralHost.numApps = 4
*.centralHost.app[0].typename = "UdpSinkApp"
*.centralHost.app[0].io.localPort = 5001
*.centralHost.app[1].typename = "UdpSinkApp"
*.centralHost.app[1].io.localPort = 5002
*.centralHost.app[2].typename = "UdpSinkApp"
*.centralHost.app[2].io.localPort = 5003
*.centralHost.app[3].typename = "UdpSinkApp"
*.centralHost.app[3].io.localPort = 5004

# Incoming stream decoding at centralHost
*.centralHost.hasIncomingStreams = true
# ============================================================
# PCAP RECORDING — enable for baseline verification
# ============================================================
*.viuSwitch.recordPcap = false
*.vcuSwitch.recordPcap = false
*.centralHost.recordPcap = false

# ============================================================
# STATISTICS — collect mean E2E delay to match Luo Table 9
*.centralHost.bridging.streamCoder.decoder.mapping = [{source: "av1", pcp: 4, stream: "av1"}, {source: "av2", pcp: 4, stream: "av2"}, {source: "radarNode", pcp: 4, stream: "radar"}, {source: "zonalHost", pcp: 7, stream: "control"}]
